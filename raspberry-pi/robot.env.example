# Copy to /etc/ga-ai-robot/robot.env, then chmod 600 it.
# NEVER commit the real values.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Optional path overrides if your Pi username/paths differ.
ROBOT_HOME=/home/raspforex
MEDIAMTX_BIN=/home/raspforex/mediamtx
MEDIAMTX_CONFIG=/home/raspforex/mediamtx.yml
ROBOT_APP=/home/raspforex/robot_app.py
